+def _escape_vega_html(chart_html: str) -> str:
+  """Escapes HTML/script-breaking sequences inside Altair's inline JSON spec."""
+  return re.sub(
+    r"^(\s*var\s+spec\s*=\s*)(.*);$",
+    lambda m: (
+      m.group(1)
+      + m.group(2)
+      .replace("&", "\\u0026")
+      .replace("<", "\\u003c")
+      .replace(">", "\\u003e")
+      + ";"
+    ),
+    chart_html,
+    flags=re.MULTILINE,
+  )
+
